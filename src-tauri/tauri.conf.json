{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glowby",
  "version": "0.6.1",
  "identifier": "dev.glowby.app",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Shadow-PJ",
    "copyright": "Copyright (c) 2026 Shadow-PJ",
    "shortDescription": "A desktop companion for Claude Code and Codex",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
